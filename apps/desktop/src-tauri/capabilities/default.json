{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. No shell, no filesystem, no dialogs from web content: file selection happens in Rust.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-capabilities",
    "allow-snapshot",
    "allow-events",
    "allow-profiles",
    "allow-country-catalog",
    "allow-update-server",
    "allow-server-health",
    "allow-refresh-server-health",
    "allow-quick-connect",
    "allow-settings",
    "allow-set-settings",
    "allow-connect",
    "allow-disconnect",
    "allow-pause-vpn",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-resume-vpn",
    "allow-pause-status",
    "allow-cancel",
    "allow-import-dialog",
    "allow-import-folder-dialog",
    "allow-new-draft",
    "allow-profile-draft",
    "allow-create-profile",
    "allow-update-profile",
    "allow-duplicate-profile",
    "allow-delete-profile",
    "allow-export-profile",
    "allow-diagnostics",
    "allow-export-diagnostics",
    "allow-speed-test",
    "allow-stop-other-vpns",
    "allow-helper-status",
    "allow-install-helper",
    "allow-open-link",
    "allow-scan-downloads",
    "allow-current-network"
  ]
}