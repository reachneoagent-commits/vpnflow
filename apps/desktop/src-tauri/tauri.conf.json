{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPNFlow",
  "mainBinaryName": "vpnflow",
  "version": "0.1.17",
  "identifier": "org.vpnflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VPNFlow",
        "width": 1280,
        "height": 840,
        "minWidth": 768,
        "minHeight": 576,
        "center": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "VPNFlow \u2014 WireGuard VPN client",
    "longDescription": "VPNFlow is a lightweight open-source WireGuard VPN client for Linux, Windows, and macOS.",
    "license": "MIT OR Apache-2.0",
    "copyright": "VPNFlow contributors",
    "resources": {
      "../../../LICENSE-MIT": "licenses/Aegis-MIT.txt",
      "../../../LICENSE-APACHE": "licenses/Aegis-Apache-2.0.txt",
      "../../../docs/releases/ASSET_LICENSES.txt": "licenses/Fonts-Icons-React.txt",
      "../../../crates/aegis-core/data/README.md": "licenses/Country-Data.md",
      "../../../crates/aegis-core/data/COPYING.iso-codes": "licenses/iso-codes-LGPL-2.1.txt",
      "../public/flags/LICENSE": "licenses/Flags-MIT.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRDMxN0FENDRBQzJENTgKUldSWUxheEVyUmZUWW1pWGpvM0RaSzVEZVE0bHZ4TjBid01SNS8rRnpCSUlJNHo1MXhrQXBvcUkK",
      "endpoints": [
        "https://github.com/reachneoagent-commits/vpnflow/releases/latest/download/latest.json"
      ]
    }
  }
}
